{
  "name": "marvira-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@marvira/api",
    "dev:dashboard": "turbo run dev --filter=@marvira/dashboard",
    "dev:marketing": "turbo run dev --filter=@marvira/marketing",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @marvira/api exec prisma generate",
    "db:migrate": "pnpm --filter @marvira/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @marvira/api run seed",
    "db:reset": "pnpm --filter @marvira/api run db:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
