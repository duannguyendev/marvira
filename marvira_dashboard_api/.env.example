# Database (native Windows PostgreSQL)
# Add connection_limit for production pools, e.g. ?connection_limit=20
DATABASE_URL=postgresql://postgres:marvira@localhost:5432/marvira?schema=public

# Redis (required in production — set REDIS_DISABLED=true only for local dev without Redis)
REDIS_URL=redis://localhost:6379
# Used by BullMQ when REDIS_URL is not enough / for host+port form
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DISABLED=true
# Log-only Bull queues (analytics/image-processing). Off by default —
# leave unset in production to avoid Upstash free-tier idle polling.
# The notifications queue runs whenever Redis is enabled (FCM worker).
# BULL_STUB_QUEUES=true

# Firebase Admin (FCM push — optional until credentials are added)
# Paste the full service-account JSON as a single line, OR use BASE64:
# FIREBASE_ADMIN_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_ADMIN_CREDENTIALS_BASE64=
# FIREBASE_ADMIN_PROJECT_ID=

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (mobile ID-token verify)
# Single web client id, or comma-separated web+iOS+Android audiences:
GOOGLE_CLIENT_ID=
# Optional alias for multiple audiences (preferred when using native clients):
# GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET is unused for mobile ID-token flow (kept for docs parity)

# Facebook OAuth (required in production — see validate-production.config.ts)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Sign-In (required in production; usually iOS bundle id e.g. com.marvira)
APPLE_CLIENT_ID=

# OAuth dev fallback (MUST be false in production)
# When true (non-production only), POST /auth/google|apple|facebook accept email+name without tokens
OAUTH_DEV_BYPASS=true

# Owner credentials checklist: ../../release_credentials.txt (repo root)
# Email — production on Railway: prefer Resend (HTTPS). Outbound SMTP is often blocked.
# https://resend.com → API key + verify marvira.com → set RESEND_API_KEY
RESEND_API_KEY=
# RESEND_FROM=Marvira <noreply@marvira.com>
#
# Gmail SMTP (works locally; on Railway often times out — check logs for "SMTP verify failed"):
#   1. Google Account → Security → 2-Step Verification ON
#   2. App passwords → Mail → copy 16-char password into SMTP_PASS
#   3. Railway ENV:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Marvira <your@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Marvira <noreply@marvira.com>
# Optional — shown in password-reset / welcome / security emails
# SUPPORT_EMAIL=support@marvira.com
# MARKETING_SITE_URL=https://www.marvira.com

# Password reset link base — public marketing site (not dashboard)
# Production: https://www.marvira.com/reset-password
PASSWORD_RESET_URL=http://localhost:3002/reset-password

# One-time DB seed (pnpm --filter @marvira/api run seed)
# Production: set strong passwords (min 12). Support uses STAFF role.
SEED_ADMIN_EMAIL=admin@marvira.com
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@marvira.com
SEED_STAFF_PASSWORD=
SEED_SUPPORT_EMAIL=support@marvira.com
SEED_SUPPORT_PASSWORD=
SEED_DEMO_EMAIL=demo@marvira.com
SEED_DEMO_PASSWORD=

# AWS S3 / Cloudflare R2 (optional — local uploads/ used when bucket not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
CDN_URL=

# PostGIS: auto-detected when postgis extension installed; set false to force haversine
USE_POSTGIS=

# Anticheat — set true only for local/test to skip GPS spoof checks
DISABLE_LOCATION_ANTICHEAT=false

# Dashboard / Marketing (public build-time vars)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CDN_URL=
# Dashboard → marketing site (article "View" links)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
# Mapbox public token (dashboard interactive map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Optional monitoring
SENTRY_DSN=

# API
PORT=3001
# Comma-separated allowed browser origins (dashboard :3000, marketing :3002)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
NODE_ENV=development

# Mobile (external project)
USE_MOCK_API=false
