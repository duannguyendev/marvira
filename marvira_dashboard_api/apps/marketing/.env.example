# Public marketing site (apps/marketing)
# See repo root: release_credentials.txt (provide real values for WEB-DEPLOY)

# Canonical site URL (used for links / Meta Privacy Policy base)
NEXT_PUBLIC_SITE_URL=https://www.marvira.example.com

# Public API (articles, feedback, invite /e/{id})
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional CDN for uploaded images in production
NEXT_PUBLIC_CDN_URL=

# Support inbox shown on /support, /privacy, /terms
NEXT_PUBLIC_SUPPORT_EMAIL=hello@marvira.example.com

# Set true only while counsel is still reviewing (shows draft banner)
# Leave unset/false for public Meta-facing deploy
# NEXT_PUBLIC_LEGAL_DRAFT=true

# Store links — leave empty until apps are live (STORE_READY stays false)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
