# Public marketing site (apps/marketing)
# See repo root: release_credentials.txt (provide real values for WEB-DEPLOY)

# Canonical site URL (used for links / Meta Privacy Policy base)
NEXT_PUBLIC_SITE_URL=https://www.marvira.com

# --- API target (developer: flip NEXT_PUBLIC_API_ENV or MANUAL in shared-utils) ---
# next dev default: local. Production deploy: production (via NEXT_PUBLIC_API_URL).
# NEXT_PUBLIC_API_ENV=local
# NEXT_PUBLIC_API_ENV=uat
# NEXT_PUBLIC_API_ENV=production
#
# NEXT_PUBLIC_API_URL_LOCAL=http://localhost:3001
# NEXT_PUBLIC_API_URL_UAT=https://api-uat.marvira.com
NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL_PRODUCTION=https://api.marvira.com

# Optional CDN for uploaded images in production
NEXT_PUBLIC_CDN_URL=

# Support inbox shown on /support, /privacy, /terms
NEXT_PUBLIC_SUPPORT_EMAIL=support@marvira.com

# Set true only while counsel is still reviewing (shows draft banner)
# Leave unset/false for public Meta-facing deploy
# NEXT_PUBLIC_LEGAL_DRAFT=true

# Store links — leave empty until apps are live (STORE_READY stays false)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
