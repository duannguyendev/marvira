generator client {
  provider      = "prisma-client-js"
  // Railway/Docker runs node:22-alpine (musl + OpenSSL 3)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  STAFF
  ADMIN
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
  LOCAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
  TRUE_FALSE
  IMAGE
}

enum QuestionSource {
  COMMUNITY
  EVENT
}

enum EventDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ModerationActionType {
  SUSPEND_PLAY_1_DAY
  SUSPEND_PLAY_2_DAYS
  SUSPEND_PLAY_1_WEEK
  SUSPEND_PLAY_1_MONTH
  LIFT_SUSPENSION
  DEACTIVATE
  ACTIVATE
  RESET_WARNING_POINTS
}

enum FeedbackCategory {
  FEEDBACK
  SUGGESTION
  BUG
  OTHER
}

enum FeedbackSource {
  WEB
  MOBILE
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
  ARCHIVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  name               String
  avatar             String?
  passwordHash       String?      @map("password_hash")
  provider           AuthProvider @default(LOCAL)
  /// Stable id from Google sub / Apple sub / Facebook id (null for LOCAL)
  providerUserId     String?      @map("provider_user_id")
  role               UserRole     @default(USER)
  isActive           Boolean      @default(true) @map("is_active")
  warningPoints      Int          @default(0) @map("warning_points")
  playSuspendedUntil DateTime?    @map("play_suspended_until")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  createdEvents         Event[]                  @relation("EventCreator")
  eventProgress         UserEventProgress[]
  placeCompletions      UserPlaceCompletion[]
  sessions              Session[]
  analyticsEvents       AnalyticsEvent[]
  passwordResetTokens   PasswordResetToken[]
  createdQuestions      Question[]               @relation("QuestionCreator")
  practiceCompletions   UserPracticeCompletion[]
  favoriteEvents        UserFavoriteEvent[]
  favoriteQuestions     UserFavoriteQuestion[]
  eventAccess           UserEventAccess[]
  locationWarnings      UserLocationWarning[]
  moderationActions     UserModerationAction[]   @relation("ModerationTarget")
  moderationActionsBy   UserModerationAction[]   @relation("ModerationAdmin")
  feedbackMessages      Feedback[]
  articles              Article[]                @relation("ArticleCreator")
  placeAnswerReports    PlaceAnswerReport[]

  @@unique([provider, providerUserId])
  @@index([warningPoints])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Event {
  id                String          @id @default(uuid())
  title             String
  description       String
  city              String
  coverImage        String?         @map("cover_image")
  difficulty        EventDifficulty @default(MEDIUM)
  rewardPoints      Int             @default(100) @map("reward_points")
  isActive          Boolean         @default(false) @map("is_active")
  scheduledPublishAt DateTime?      @map("scheduled_publish_at")
  /// When the live event is scheduled to auto-end (UTC)
  endsAt            DateTime?       @map("ends_at")
  /// When the event actually ended (manual or auto)
  endedAt           DateTime?       @map("ended_at")
  /// Content language: vi | en | zh | ja (not UI i18n)
  language          String          @default("vi")
  joinPasswordHash  String?         @map("join_password_hash")
  completionMessage String?         @map("completion_message")
  giftTeaser        String?         @map("gift_teaser")
  giftCodes         String[]        @default([]) @map("gift_codes")
  createdBy         String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  creator        User              @relation("EventCreator", fields: [createdBy], references: [id])
  places         Place[]
  progress       UserEventProgress[]
  eventQuestions EventQuestion[]
  favoritedBy    UserFavoriteEvent[]
  accessGrants   UserEventAccess[]
  articles       Article[]
  publishVerifyPasses EventPublishVerifyPass[]
  answerReports       PlaceAnswerReport[]

  @@index([city])
  @@index([isActive])
  @@index([scheduledPublishAt])
  @@index([endsAt])
  @@index([endedAt])
  @@index([language])
  @@map("events")
}

model Place {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  title        String
  description  String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100) @map("radius_meters")
  orderIndex   Int      @map("order_index")
  hint         String?
  questionId   String?  @map("question_id")
  createdAt    DateTime @default(now()) @map("created_at")

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question    Question?             @relation(fields: [questionId], references: [id], onDelete: SetNull)
  completions UserPlaceCompletion[]
  answerReports PlaceAnswerReport[]

  @@index([eventId, orderIndex])
  @@map("places")
}

model Question {
  id          String         @id @default(uuid())
  question    String
  type        QuestionType   @default(TEXT)
  imageUrl    String?        @map("image_url")
  options     Json?
  answer      String
  answerUpdatedAt DateTime? @map("answer_updated_at")
  explanation String?
  points      Int            @default(10)
  /// Content language: vi | en | zh | ja (not UI i18n)
  language    String         @default("vi")
  createdBy   String?        @map("created_by")
  source      QuestionSource @default(EVENT)
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  creator             User?                    @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  eventQuestions      EventQuestion[]
  places              Place[]
  practiceCompletions UserPracticeCompletion[]
  favoritedBy         UserFavoriteQuestion[]
  publishVerifyPasses EventPublishVerifyPass[]

  @@index([source, isPublished])
  @@index([source, isPublished, language])
  @@index([createdBy])
  @@index([language])
  @@map("questions")
}

model EventQuestion {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  questionId String @map("question_id")
  orderIndex Int    @default(0) @map("order_index")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([eventId, questionId])
  @@index([eventId, orderIndex])
  @@map("event_questions")
}

model UserEventProgress {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  eventId           String    @map("event_id")
  currentPlaceIndex Int       @default(0) @map("current_place_index")
  completed         Boolean   @default(false)
  score             Int       @default(0)
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  /// Wall-clock ms from first place unlock to event completion (for leaderboards)
  totalDurationMs   Int?      @map("total_duration_ms")
  /// 1-based finish rank by soonest completedAt (gift assignment); snapshot at finish
  finishRank        Int?      @map("finish_rank")
  /// Gift code assigned at finish, if any; immutable snapshot
  giftCodeAwarded   String?   @map("gift_code_awarded")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([eventId, completed, score, totalDurationMs])
  @@index([eventId, completed, completedAt])
  @@map("user_event_progress")
}

model UserEventAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("user_event_access")
}

model UserPlaceCompletion {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  placeId          String    @map("place_id")
  completed        Boolean   @default(false)
  answer           String?
  unlockedAt       DateTime? @map("unlocked_at")
  completedAt      DateTime? @map("completed_at")
  /// Ms from unlock at this place to first correct answer (includes retries)
  answerDurationMs Int?      @map("answer_duration_ms")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@map("user_place_completion")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  eventName String   @map("event_name")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([createdAt])
  @@map("analytics_events")
}

model UserPracticeCompletion {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  questionId  String   @map("question_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("user_practice_completions")
}

model UserFavoriteEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@map("user_favorite_events")
}

model UserFavoriteQuestion {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("user_favorite_questions")
}

model UserLocationWarning {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String
  placeId   String?  @map("place_id")
  eventId   String?  @map("event_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([code])
  @@map("user_location_warnings")
}

model UserModerationAction {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  adminId   String               @map("admin_id")
  action    ModerationActionType
  reason    String?
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")

  user  User @relation("ModerationTarget", fields: [userId], references: [id], onDelete: Cascade)
  admin User @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_moderation_actions")
}

model Feedback {
  id        String           @id @default(uuid())
  userId    String?          @map("user_id")
  name      String
  email     String
  category  FeedbackCategory
  subject   String?
  message   String
  source    FeedbackSource
  status    FeedbackStatus   @default(NEW)
  adminNote String?          @map("admin_note")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([source])
  @@index([createdAt])
  @@map("feedback")
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  placeName   String        @map("place_name")
  city        String?
  excerpt     String
  body        String
  coverImage  String?       @map("cover_image")
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  eventId     String?       @map("event_id")
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  creator User   @relation("ArticleCreator", fields: [createdBy], references: [id])
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([placeName])
  @@index([city])
  @@map("articles")
}

model EventPublishVerifyPass {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  questionId String   @map("question_id")
  verifiedAt DateTime @default(now()) @map("verified_at")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([eventId, questionId])
  @@index([eventId])
  @@map("event_publish_verify_passes")
}

model PlaceAnswerReport {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  placeId        String   @map("place_id")
  eventId        String   @map("event_id")
  reportedAt     DateTime @default(now()) @map("reported_at")
  lastReportedAt DateTime @default(now()) @map("last_reported_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([eventId])
  @@map("place_answer_reports")
}

/// Global key/value product settings (admin/staff editable).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
