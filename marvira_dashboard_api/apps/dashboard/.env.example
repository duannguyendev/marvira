# Dashboard (apps/dashboard) — copy to .env.local for next dev
#
# NEXT_PUBLIC_API_ENV=local|uat|production  (default local in next dev)
# Or set MANUAL_PUBLIC_API_ENV in packages/shared-utils/src/public-api-url.ts
#
# NEXT_PUBLIC_API_URL_LOCAL=http://localhost:3001
# NEXT_PUBLIC_API_URL_UAT=https://api-uat.marvira.com
NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL_PRODUCTION=https://api.marvira.com
# Required for place location map picker (Mapbox public token, pk.…):
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
