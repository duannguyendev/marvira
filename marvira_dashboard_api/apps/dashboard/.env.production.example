# Production build — copy to .env.production and set values before deploy
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Optional explicit env (default production when NODE_ENV=production):
# NEXT_PUBLIC_API_ENV=production
# NEXT_PUBLIC_API_URL_UAT=https://api-uat.yourdomain.com
# When S3/CDN serves uploads, set CDN base (absolute URLs in API responses)
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
