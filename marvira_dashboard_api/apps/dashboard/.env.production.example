# Production build — copy to .env.production and set values before deploy
NEXT_PUBLIC_API_URL=https://api.marvira.com
# Public marketing site (article "View" links → /explore/:slug)
NEXT_PUBLIC_MARKETING_URL=https://www.marvira.com
# Required for place location map picker (Mapbox public token, pk.…):
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional explicit env (default production when NODE_ENV=production):
# NEXT_PUBLIC_API_ENV=production
# NEXT_PUBLIC_API_URL_UAT=https://api-uat.marvira.com
# When S3/CDN serves uploads, set CDN base (absolute URLs in API responses)
# NEXT_PUBLIC_CDN_URL=https://cdn.marvira.com
