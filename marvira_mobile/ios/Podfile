# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Keep New Architecture aligned with android/gradle.properties
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# RN 0.84+ defaults to prebuilt RNCore, which breaks RNFB under use_frameworks.
# https://github.com/invertase/react-native-firebase/issues/8883
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'

# React Native Firebase — static frameworks (required)
$RNFirebaseAsStaticFramework = true
# Analytics without IDFA / ATT for v1.0 (ads later can revisit)
$RNFirebaseAnalyticsWithoutAdIdSupport = true

prepare_react_native_project!

platform :ios, '16.0'

use_frameworks! :linkage => :static

# Force RNFB pods to static libraries (needed alongside $RNFirebaseAsStaticFramework on RN 0.85)
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('RNFB')
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'Marvira' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end
end
