# Copy to `.env.local` for local builds (never commit `.env.local`).
# On Codemagic, set the same names as Secure environment variables.
# Owner checklist: ../release_credentials.txt (repo root)
#
# Then just:
#   yarn android / yarn ios
#   or Run from Android Studio / Xcode
#   or Start Build on Codemagic
#
# No secrets:apply script — missing required values fail the build.

# Required for Maps (local + Codemagic)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Required for release / store JS only (ignored in Metro __DEV__; uses localhost)
API_BASE_URL=https://api.marvira.example.com
MARKETING_SITE_URL=https://www.marvira.example.com

# Social login (optional until owner provides — buttons show clear errors if empty)
# Google: use the *Web* OAuth client id (also used as GoogleSignin webClientId)
GOOGLE_WEB_CLIENT_ID=
# Facebook: same App ID as API FACEBOOK_APP_ID; Client Token from Meta dashboard
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
# Apple: no mobile ENV — enable Sign In with Apple capability; API needs APPLE_CLIENT_ID=com.marvira

# Optional Firebase (Codemagic). Locally you can replace the placeholder config files instead.
# GOOGLE_SERVICES_JSON_BASE64=
# GOOGLE_SERVICE_INFO_PLIST_BASE64=
